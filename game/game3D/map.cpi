main map {
  avoid {
    set main std
    set undo ref giff(main giff)

    main map
    undo ref (athlon; main athlon)

    decadence(?undo ref; -athlon)
    decadence2(-main.athlon.ero/athlon)

    athlon(athlon(main super: super.atomty))
    set map
  }
}

set main
maincharacter(use route(xreoct/game/game3D/character.cpi))
